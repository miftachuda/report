              </tbody>
            </table>
          </div>

          <!-- ISSUE MAINTENANCE -->
          <div class="card" style="flex-grow: 1">
            <div class="card-title">ISSUE MAINTENANCE</div>
            <table>
              <thead>
                <tr>
                  <th style="width: 20%">Equipment</th>
                  <th style="width: 25%">Issue</th>
                  <th style="width: 55%">Mitigasi / RTL</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="text-center">024P-107A</td>
                  <td>Motor vibrasi</td>
                  <td>Perbaikan motor di WS bls ( WO No. 8302570004 )</td>
                </tr>
                <tr>
                  <td class="text-center">002P-101A</td>
                  <td>Casing bocor</td>
                  <td>Perbaikan pompa di WS bls</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
