                  <td class="text-center">151 T/D</td>
                  <td>
                    <div class="sample-grid">
                      <span class="font-bold">Visco</span>
                      <span class="font-bold">FP</span>
                      <span class="font-bold">COL</span>
                      <span></span><span></span><span></span>
                      <span class="text-green">43.81</span>
                      <span class="text-green">288</span>
                      <span class="text-green">L7.5</span>
                    </div>
                  </td>
                  <td class="onspec-cell">(OnSpec)</td>
                </tr>
                <tr>
                  <td>ASPHALT<br /><span class="font-bold">42T-10</span></td>
                  <td class="text-center">484 T/D</td>
                  <td></td>
