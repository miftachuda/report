                  <th style="width: 16%">UNIT</th>
                  <th style="width: 18%">Produk</th>
                  <th style="width: 12%">AKTUAL</th>
                  <th style="width: 42%">ANALISA SAMPLE</th>
                  <th style="width: 12%">STATUS</th>
                </tr>
              </thead>
              <tbody>
                <!-- UNIT 021 HVU II -->
                <tr>
                  <td rowspan="4" class="text-center">UNIT 021 HVU II</td>
                  <td>SPO DIST<br /><span class="font-bold">LOC I</span></td>
                  <td class="text-center">250 T/D</td>
                  <td>
                    <div class="sample-grid">
                      <span class="font-bold">Visco</span>
                      <span class="text-green">12.50</span>
                      <span class="font-bold">cSt</span>
                    </div>
                  </td>
                  <td class="onspec-cell">(OnSpec)</td>
                </tr>
                <tr>
                  <td>LMO DIST<br /><span class="font-bold">041T-116</span></td>
                  <td class="text-center">273 T/D</td>
                  <td>
                    <div class="sample-grid">
                      <span class="font-bold">Visco</span>
                      <span class="text-green">31.21</span>
                      <span class="font-bold">cSt</span>
                    </div>
                  </td>
                  <td class="onspec-cell">(OnSpec)</td>
                </tr>
                <tr>
                  <td>MMO DIST<br /><span class="font-bold">041T-117</span></td>
                  <td class="text-center">460 T/D</td>
                  <td>
                    <div class="sample-grid">
                      <span class="font-bold">Visco</span>
