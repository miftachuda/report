<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Daily Report LOC II</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      }

      body {
        background-color: #eef5f9;
        padding: 15px;
        color: #222;
        font-size: 11.5px;
      }

      .dashboard-container {
        max-width: 1650px;
        margin: 0 auto;
        background-color: #fff;
        border: 2px solid #ccc;
        border-radius: 12px;
        overflow: hidden;
        padding: 12px;
      }

      /* HEADER */
      .top-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(90deg, #f3b100 0%, #f7b900 100%);
        height: 55px;
        border-radius: 6px;
        margin-bottom: 10px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      }

      .logo-left,
      .logo-right {
        background: #fff;
        height: 100%;
        display: flex;
        align-items: center;
        padding: 0 25px;
        font-weight: bold;
        font-size: 14px;
      }

      .logo-left {
        clip-path: polygon(0 0, 100% 0, 85% 100%, 0% 100%);
        padding-right: 45px;
      }

      .logo-right {
        clip-path: polygon(15% 0, 100% 0, 100% 100%, 0% 100%);
        padding-left: 45px;
      }

      .banner-title {
        font-size: 22px;
        font-weight: 800;
        color: #111;
        letter-spacing: 0.5px;
      }

      /* DATE BAR */
      .date-bar {
        background: #fff;
        padding: 8px 15px;
        border-bottom: 2px solid #e0e0e0;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 12px;
        display: flex;
        gap: 20px;
      }

      /* MAIN GRID */
      .main-grid {
        display: grid;
        grid-template-columns: 52.5% 46.5%;
        gap: 1%;
      }

      .left-col,
      .right-col {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      /* CARD & TABLE STYLING */
      .card {
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #b8c4ce;
        background-color: #fdf2d0;
        display: flex;
        flex-direction: column;
      }

      .card-title {
        background: linear-gradient(180deg, #0093e0 0%, #0076be 100%);
        color: #fff;
        text-align: center;
        font-weight: 700;
        font-size: 13px;
        padding: 6px;
        letter-spacing: 0.5px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th {
        background-color: #d9e7f4;
        color: #111;
        font-weight: 700;
        padding: 6px 4px;
        border: 1px solid #b8c4ce;
        text-align: center;
        font-size: 11px;
      }

      td {
        background-color: #fdf2d0;
        padding: 5px 6px;
        border: 1px solid #dcd3b8;
        vertical-align: middle;
        font-size: 11px;
      }

      /* UTILITIES */
      .text-center {
        text-align: center;
      }
      .text-right {
        text-align: right;
      }
      .text-left {
        text-align: left;
      }
      .font-bold {
        font-weight: 700;
      }
      .text-green {
        color: #1f9d55;
        font-weight: 700;
      }
      .text-red {
        color: #d9381e;
        font-weight: 700;
      }

      /* STATUS DOTS & BADGES */
      .status-cell {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 2px;
      }

      .dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
      }
      .dot-green {
        background-color: #4caf50;
        border: 1px solid #2e7d32;
      }

      .onspec-cell {
        background-color: #16a34a !important;
        color: #fff !important;
        font-weight: 700;
        text-align: center;
      }

      /* SAMPLE GRID INSIDE PRODUKSI */
      .sample-grid {
        display: grid;
        grid-template-columns: repeat(6, auto);
        gap: 2px 8px;
        align-items: center;
        justify-content: start;
      }

      /* ISSUE OPERATIONAL BOX */
      .operational-box {
        padding: 10px 25px;
        min-height: 110px;
        background-color: #fdf2d0;
        line-height: 1.6;
        font-size: 11.5px;
      }
    </style>
  </head>
  <body>
    <div class="dashboard-container">
      <!-- TOP HEADER -->
      <div class="top-banner">
        <div class="logo-left">
          <span>Danantara Indonesia</span>
        </div>
        <div class="banner-title">DAILY REPORT LOC II</div>
        <div class="logo-right">
          <span
            >PERTAMINA
            <small style="display: block; font-size: 9px; color: #c00"
              >PATRA NIAGA</small
            ></span
          >
        </div>
      </div>

      <!-- DATE BAR -->
      <div class="date-bar">
        <span>Tanggal:</span>
        <span>Sabtu, 17 Oktober 2026</span>
      </div>

      <!-- MAIN CONTENT GRID -->
      <div class="main-grid">
        <!-- LEFT COLUMN -->
        <div class="left-col">
          <!-- KAPASITAS FEED + HOS II + TANK FARM + CPI -->
          <div class="card">
            <div class="card-title">KAPASITAS FEED</div>
            <table>
              <thead>
                <tr>
                  <th style="width: 15%">UNIT</th>
                  <th style="width: 15%">Status</th>
                  <th style="width: 11%">Design (T/D)</th>
                  <th style="width: 11%">Aktual (T/D)</th>
                  <th style="width: 13%">Target RPH (T/D)</th>
                  <th style="width: 11%">Target STS</th>
                  <th style="width: 8%">% Design</th>
                  <th style="width: 8%">% PRH</th>
                  <th style="width: 8%">% STS</th>
                </tr>
              </thead>
              <tbody>
                <!-- UNIT 021 -->
                <tr>
                  <td class="text-center">UNIT 021 HVU II</td>
                  <td class="text-center text-green">Normal Operasi</td>
                  <td class="text-center">3883</td>
                  <td class="text-center">2583</td>
                  <td class="text-center">2524</td>
                  <td class="text-center">2524</td>
                  <td>
                    <div class="status-cell">
                      <span class="dot dot-green"></span><span>66.5</span>
                    </div>
                  </td>
                  <td>
                    <div class="status-cell">
                      <span class="dot dot-green"></span><span>102.4</span>
                    </div>
                  </td>
                  <td>
                    <div class="status-cell">
                      <span class="dot dot-green"></span><span>102.4</span>
                    </div>
                  </td>
                </tr>
                <!-- UNIT 022 -->
                <tr>
                  <td class="text-center">UNIT 022 PDU II</td>
                  <td class="text-center text-green">Normal Operasi</td>
                  <td class="text-center">784</td>
                  <td class="text-center">635</td>
                  <td class="text-center">627</td>
                  <td class="text-center">549</td>
                  <td>
                    <div class="status-cell">
                      <span class="dot dot-green"></span><span>81.1</span>
                    </div>
                  </td>
                  <td>
                    <div class="status-cell">
                      <span class="dot dot-green"></span><span>101.3</span>
                    </div>
                  </td>
                  <td>
                    <div class="status-cell">
                      <span class="dot dot-green"></span><span>115.8</span>
                    </div>
                  </td>
                </tr>
                <!-- UNIT 023 -->
                <tr>
                  <td class="text-center">UNIT 023 FEU II</td>
                  <td rowspan="2" class="text-center text-green">
                    Normal Operasi
                  </td>
                  <td rowspan="2" class="text-center">2270</td>
                  <td rowspan="2" class="text-center">1750</td>
                  <td rowspan="2" class="text-center">1476</td>
                  <td rowspan="2" class="text-center">1476</td>
                  <td rowspan="2">
                    <div class="status-cell">
                      <span class="dot dot-green"></span><span>77.1</span>
                    </div>
                  </td>
                  <td rowspan="2">
                    <div class="status-cell">
                      <span class="dot dot-green"></span><span>118.6</span>
                    </div>
                  </td>
                  <td rowspan="2">
                    <div class="status-cell">
                      <span class="dot dot-green"></span><span>118.6</span>
                    </div>
                  </td>
                </tr>
                <tr>
                  <td class="text-center font-bold">MMO</td>
                </tr>
                <!-- UNIT 024 -->
                <tr>
                  <td class="text-center">UNIT 024 MDU II</td>
                  <td rowspan="2" class="text-center text-green">
                    Normal Operasi
                  </td>
                  <td rowspan="2" class="text-center">841</td>
                  <td rowspan="2" class="text-center">561</td>
                  <td rowspan="2" class="text-center">547</td>
                  <td rowspan="2" class="text-center">547</td>
                  <td rowspan="2">
                    <div class="status-cell">
                      <span class="dot dot-green"></span><span>66.7</span>
                    </div>
                  </td>
                  <td rowspan="2">
                    <div class="status-cell">
                      <span class="dot dot-green"></span><span>102.6</span>
                    </div>
                  </td>
                  <td rowspan="2">
                    <div class="status-cell">
                      <span class="dot dot-green"></span><span>102.6</span>
                    </div>
                  </td>
                </tr>
                <tr>
                  <td class="text-center font-bold">LMO</td>
                </tr>

                <!-- HOS II SUB-TABLE -->
                <tr>
                  <th>UNIT</th>
                  <th>Status</th>
                  <th>Pompa HOS</th>
                  <th>Aktual (T/D)</th>
                  <th>Burner FG/FO</th>
                  <th colspan="4">Level 023C104</th>
                </tr>
                <tr>
                  <td class="text-center">HOS II</td>
                  <td class="text-center text-green">Normal Operasi</td>
                  <td class="text-center">025P101AT</td>
                  <td class="text-center">23808</td>
                  <td class="text-center">12 Gas / 4 Oil</td>
                  <td colspan="4" class="text-center">1.4</td>
                </tr>

                <!-- TANK FARM & CPI SUB-TABLE -->
                <tr>
                  <th>UNIT</th>
                  <th>Produksi (MTon)</th>
                  <th>Flow HVI 95</th>
                  <th>Flow HVI 160S</th>
                  <th>Flow HVI 650</th>
                  <th colspan="2">Level CPI (%)</th>
                  <th colspan="2">VISUAL PERAIRAN</th>
                </tr>
                <tr>
                  <td rowspan="2" class="text-center">Tank Farm</td>
                  <td class="text-center font-bold">LOC II</td>
                  <td class="text-center">465</td>
                  <td class="text-center">0</td>
                  <td class="text-center">0</td>
                  <td colspan="2" class="text-center">22.0</td>
                  <td colspan="2" class="text-center">CLEAR</td>
                </tr>
                <tr>
                  <td class="text-center font-bold">LOC III</td>
                  <td class="text-center">0</td>
                  <td class="text-center">0</td>
                  <td class="text-center">256</td>
                  <th colspan="4">STATUS POMPA CPI</th>
                </tr>
                <tr>
                  <th colspan="2">Stock Product (MTon)</th>
                  <th>HVI 95</th>
                  <th>HVI 160S</th>
                  <th>HVI 650</th>
                  <th colspan="2">002P101A</th>
                  <th colspan="2">002P101B</th>
                </tr>
                <tr>
                  <td colspan="2" class="text-center font-bold">Tank Farm</td>
                  <td class="text-center">2951</td>
                  <td class="text-center">1048</td>
                  <td class="text-center">3481</td>
                  <td colspan="2" class="text-center">Perbaikan</td>
                  <td colspan="2" class="text-center">AUTO</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- ISSUE OPERASIONAL -->
          <div class="card" style="flex-grow: 1">
            <div class="card-title">ISSUE OPERASIONAL</div>
            <div class="operational-box">
              <ol>
                <li>Unit FEU II 023 : Ketahanan stock furfural</li>
                <li>024K-101 : Temperature discharge panas & ASC hunting</li>
                <li>021F-102 : Flow fuel gas max 197 M3/h</li>
              </ol>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="right-col">
          <!-- PRODUKSI -->
