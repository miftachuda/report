                <!-- UNIT 023 FEU II -->
                <tr>
                  <td rowspan="2" class="text-center">UNIT 023 FEU II</td>
                  <td>RAFFINATE<br /><span class="font-bold">41T-315</span></td>
                  <td class="text-center">1106 T/D</td>
                  <td>
                    <div class="sample-grid">
                      <span class="font-bold">Visco</span>
                      <span class="font-bold">FP</span>
                      <span class="font-bold">RI</span>
